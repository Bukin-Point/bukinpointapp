generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH MODELS (Better Auth)
// ============================================

model User {
  id            String   @id @default(cuid())
  clerkUserId   String?  @unique // Clerk user ID - links to Clerk authentication
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  // phone         String?  // Optional phone number for customers - uncomment after migration
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  userProviders    UserProvider[]
  provider         Provider?
  sessions         Session[]
  accounts         Account[]
  bookings         Booking[]
  wallet           Wallet?

  @@index([email])
  @@index([clerkUserId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([token])
  @@index([userId])
  @@map("session")
}

// ============================================
// MULTI-TENANT CORE
// ============================================

model Provider {
  id              String          @id @default(cuid())
  userId          String         @unique
  businessName    String
  subdomain       String?        @unique
  industry        String
  address         String?
  phone           String
  email           String
  timezone        String         @default("Africa/Lagos")
  businessImage   String?        // Optional business image URL
  status          ProviderStatus @default(ACTIVE)
  paymentGateway  PaymentGateway? // Optional per-provider override; null = use global default
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  userProviders UserProvider[]
  bookings     Booking[]
  availability Availability[]
  wallet       Wallet?
  invitations  StaffInvitation[]

  @@index([status])
  @@index([userId])
}

enum ProviderStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

// Payment gateway choice: global default and optional per-provider override
enum PaymentGateway {
  OPAY
  PAYSTACK
}

// ============================================
// RBAC (Role-Based Access Control)
// ============================================

// ============================================
// RBAC (Role-Based Access Control)
// ============================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "SUPERADMIN", "PROVIDER_ADMIN", "STAFF", "CUSTOMER"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProviderRoles UserProviderRole[]
  rolePermissions   RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "manage:settings", "view:bookings"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions         RolePermission[]
  userProviderPermissions UserProviderPermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// The central "Membership" Record
model UserProvider {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  isOwner    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Roles & Permissions
  roles       UserProviderRole[]
  permissions UserProviderPermission[]
  
  // Operational Data
  availability Availability[]
  bookings     Booking[]        @relation("StaffBookings")
  services     UserProviderService[]

  @@unique([userId, providerId])
  @@index([providerId])
  @@index([userId])
}

model UserProviderRole {
  id             String   @id @default(cuid())
  userProviderId String
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userProvider UserProvider @relation(fields: [userProviderId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userProviderId, roleId])
}

model UserProviderPermission {
  id             String   @id @default(cuid())
  userProviderId String
  permissionId   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userProvider UserProvider @relation(fields: [userProviderId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userProviderId, permissionId])
}

// Link Users (Staff) to Services they can perform
model UserProviderService {
  id             String @id @default(cuid())
  userProviderId String
  serviceId      String
  
  userProvider   UserProvider @relation(fields: [userProviderId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userProviderId, serviceId])
  @@index([userProviderId])
  @@index([serviceId])
}

// ============================================

// ============================================
// SERVICES
// ============================================

model Service {
  id          String   @id @default(cuid())
  providerId  String
  name        String
  description String?
  image       String?  // Optional service image URL
  duration    Int // minutes
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider             Provider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings             Booking[]
  userProviderServices UserProviderService[]

  @@index([providerId, isActive])
}

// ============================================
// STAFF INVITATIONS
// ============================================

model StaffInvitation {
  id         String    @id @default(cuid())
  providerId String
  email      String
  token      String    @unique
  // role       StaffRole @default(STAFF) // TODO: Update to use Role ID later
  roleId     String?   // Optional default role to assign
  serviceIds String    @default("[]") // JSON array of service IDs
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@index([providerId])
}

// ============================================
// AVAILABILITY
// ============================================

model Availability {
  id             String    @id @default(cuid())
  providerId     String
  userProviderId String    // Replaces staffId
  dayOfWeek      Int // 0-6 (Sunday-Saturday)
  startTime      String // "09:00"
  endTime        String // "17:00"
  isBlocked      Boolean   @default(false)
  blockedDate    DateTime? // specific date override
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userProvider UserProvider @relation(fields: [userProviderId], references: [id], onDelete: Cascade)

  @@index([providerId, userProviderId, dayOfWeek])
  @@index([userProviderId, blockedDate])
}

// ============================================
// BOOKINGS
// ============================================

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id             String        @id @default(cuid())
  bookingRef     String        @unique @default(cuid())
  providerId     String
  serviceId      String
  userProviderId String        // Replaces staffId
  userId         String? // Optional: link to customer account
  customerName   String
  customerPhone  String
  customerEmail  String?
  bookingDate    DateTime
  startTime      String // "10:00"
  endTime        String // "11:00"
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentRef     String?
  consentGiven   Boolean       @default(false)
  notes          String?
  completionCode String?       @db.VarChar(4)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userProvider UserProvider @relation("StaffBookings", fields: [userProviderId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  transaction  Transaction?

  @@index([providerId, bookingDate, status])
  @@index([userProviderId, bookingDate])
  @@index([bookingRef])
  @@index([customerPhone])
  @@index([userId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================
// PAYMENTS & WALLET
// ============================================

model Transaction {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  platformFee     Decimal       @db.Decimal(10, 2)
  netAmount       Decimal       @db.Decimal(10, 2)
  paymentProvider String        @default("SIMULATED")
  providerRef     String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Wallet {
  id             String    @id @default(cuid())
  providerId     String?   @unique
  userId         String?   @unique
  balance        Decimal   @default(0) @db.Decimal(10, 2)
  pendingBalance Decimal   @default(0) @db.Decimal(10, 2)
  totalEarnings  Decimal   @default(0) @db.Decimal(10, 2)
  lastSettlement DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Global payment gateway configuration (single row; default = PAYSTACK)
model PaymentConfig {
  id                     String         @id @default(cuid())
  currentGateway         PaymentGateway @default(PAYSTACK)
  platformFeePercentage  Decimal        @default(2.5) @db.Decimal(5, 2)
  platformFeeCap         Decimal        @default(2000) @db.Decimal(10, 2)
  updatedAt              DateTime       @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // For email/password authentication - Better Auth stores password here
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
